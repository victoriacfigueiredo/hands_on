digraph DFG {
  rankdir=LR;
  node [shape=box, style=rounded, fontname=Helvetica];
  "START" [shape=circle, style=filled, fillcolor=lightgreen];
  "END" [shape=circle, style=filled, fillcolor=lightcoral];
  "START" -> "Login" [label="21"];
  "Logout" -> "END" [label="20"];
  "Acesso_Arquivo_Sensivel" -> "END" [label="1"];
  "Login" -> "Acesso_Arquivo_Sensivel" [label="16", color=black];
  "Acesso_Arquivo_Sensivel" -> "Logout" [label="17", color=black];
  "Login" -> "Acesso_Arquivo_Normal" [label="2", color=black];
  "Acesso_Arquivo_Normal" -> "Acesso_Arquivo_Sensivel" [label="2", color=black];
  "Acesso_Arquivo_Sensivel" -> "Acesso_Arquivo_Sensivel" [label="7", color=black];
  "Login" -> "Acesso_Negado" [label="1", color=black];
  "Acesso_Negado" -> "Acesso_Arquivo_Sensivel" [label="1", color=black];
  "Login" -> "Busca_Arquivos" [label="2", color=black];
  "Busca_Arquivos" -> "Acesso_Arquivo_Sensivel" [label="2", color=black];
  "Acesso_Arquivo_Sensivel" -> "Acesso_Negado" [label="1", color=black];
  "Acesso_Negado" -> "Logout" [label="1", color=black];
  "Acesso_Arquivo_Sensivel" -> "Compactar_Arquivos" [label="2", color=black];
  "Compactar_Arquivos" -> "Upload_Externo" [label="1", color=black];
  "Upload_Externo" -> "Logout" [label="1", color=black];
  "Compactar_Arquivos" -> "Copia_Dispositivo_USB" [label="1", color=black];
  "Copia_Dispositivo_USB" -> "Logout" [label="1", color=black];
}